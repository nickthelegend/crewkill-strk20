# ── network ──────────────────────────────────────────────────────────────────────────
# devnet | sepolia | mainnet
NETWORK=devnet
# Overrides the built-in RPC for the selected network.
# RPC_URL=

# ── database ─────────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://crewkill:crewkill@localhost:5433/crewkill

# ── keeper account ───────────────────────────────────────────────────────────────────
# Owns the contracts and pays for lifecycle transactions. On devnet, take one from:
#   curl -s -X POST http://localhost:5050/rpc -H 'content-type: application/json' \
#     -d '{"jsonrpc":"2.0","id":1,"method":"devnet_getPredeployedAccounts","params":{}}'
KEEPER_ADDRESS=
KEEPER_PRIVATE_KEY=

# ── house agents on a real pool ──────────────────────────────────────────────────────
# Required only when NETWORK is sepolia or mainnet. Without all three the keeper disables
# agents and says so at boot — it will not fake a private transaction.
# PROVING_SERVICE_URL=
# INDEXER_URL=
# AGENT_VIEWING_KEY=

# ── behaviour ────────────────────────────────────────────────────────────────────────
PORT=8080
AUTO_MATCH=true
POLL_INTERVAL_MS=2000

# Phase lengths in seconds. Shorten them to fit a whole match into a demo.
# PHASE_LOBBY=90
# PHASE_NIGHT=20
# PHASE_MEETING=45
# PHASE_VOTING=30
# PHASE_REVEAL=60
