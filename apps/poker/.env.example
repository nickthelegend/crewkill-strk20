# Which chain the poker client talks to. `devnet` loads /deployed-poker.json and prefunded
# local accounts; anything else uses a real wallet through the Cartridge connector.
VITE_NETWORK=sepolia

# The Texas Hold'em contract. The verifiers it calls are wired into it at deploy time, so
# only this address is needed here.
VITE_CONTRACT_ADDRESS=0x028fcd7d6937f5a2c1cefd07b6b26faedd0e99383b1f632e9754c4ba0941cbd9
VITE_RPC_URL=https://api.cartridge.gg/x/starknet/sepolia
