# The STRK20 Privacy SDK is published to GitHub Packages, not npmjs.
# NODE_AUTH_TOKEN is read from the environment — never commit a token here.
@starkware-libs:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
# Prisma and esbuild need their postinstall scripts to fetch native engines.
enable-pre-post-scripts=true
