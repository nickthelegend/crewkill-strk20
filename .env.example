# Copy to .env and fill in. Never commit the real file.

# ── Starknet RPC ──────────────────────────────────────────────────────────────────
# Sepolia testnet. Create a free key at https://www.alchemy.com
SEPOLIA_RPC=https://starknet-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Mainnet, CHAIN_ID SN_MAIN. Only set this when you actually intend to touch mainnet.
# MAINNET_RPC=https://starknet-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# ── Keeper account ────────────────────────────────────────────────────────────────
# The account that signs match lifecycle transactions. On devnet these come from
# `pnpm devnet:accounts`; on a public network use a funded account you control.
KEEPER_ADDRESS=
KEEPER_PRIVATE_KEY=

# ── Database ──────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://crewkill:crewkill@localhost:5433/crewkill

# ── Privacy SDK (house agents against the real STRK20 pool) ───────────────────────
# Without these the keeper still runs, but house agents are disabled: seats bought
# through the real pool need a prover and a discovery indexer.
# PROVING_SERVICE_URL=
# INDEXER_URL=
# AGENT_VIEWING_KEY=
